{
	"name": "p1_products_incremental_",
	"properties": {
		"activities": [
			{
				"name": "Lookup_get_watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": "SELECT last_load_time \nFROM retail.watermark \nWHERE table_name ='products';",
