		{
			"name": "[concat(parameters('factoryName'), '/p1_customer_incremental')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_get_watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "SELECT last_load_time \nFROM retail.watermark \nWHERE table_name ='customer';",
								"queryTimeout": "02:00:00"
							},
							"dataset": {
								"referenceName": "ds_pg_customer",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "copyCustomer_incremental",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Lookup_get_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": {
									"value": "@concat(\n    'select * from retail.customer where updated_at > ''',\n    activity('Lookup_get_watermark').output.firstRow.last_load_time,''''\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_pg_customer",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_customers",
								"type": "DatasetReference",
								"parameters": {
									"directory": {
										"value": "@concat(\n    'customers/load_date=',\n    formatDateTime(utcNow(),'yyyy-MM-dd')\n)",
										"type": "Expression"
									},
									"filename": "customer.csv"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-06-23T13:32:17Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_pg_customer')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_customers')]"
			]
